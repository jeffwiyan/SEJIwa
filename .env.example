# Persistent SQLite database location (relative to project root or absolute).
DATABASE_PATH=./data/sejiwa.sqlite
PORT=3000

# Optional role-specific demo accounts.
# Set a unique password of at least 12 characters for each role you want to test.
# Demo accounts are only created when both email and password are configured.
DEMO_EMPLOYEE_EMAIL=employee.demo@sejiwa.local
DEMO_EMPLOYEE_PASSWORD=
DEMO_PSYCHOLOGIST_EMAIL=psychologist.demo@sejiwa.local
DEMO_PSYCHOLOGIST_PASSWORD=
DEMO_CASE_MANAGER_EMAIL=casemanager.demo@sejiwa.local
DEMO_CASE_MANAGER_PASSWORD=
DEMO_ADMIN_EMAIL=admin.demo@sejiwa.local
DEMO_ADMIN_PASSWORD=
