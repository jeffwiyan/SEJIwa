# Persistent SQLite database location (relative to project root or absolute).
DATABASE_PATH=./data/sejiwa.sqlite
PORT=3000

# Optional role-specific accounts for local demonstration/testing.
# Leave unset to require users to register and admins to be provisioned explicitly.
# Accounts are created or refreshed only when both email and password are configured.
DEMO_EMPLOYEE_EMAIL=
DEMO_EMPLOYEE_PASSWORD=
DEMO_PSYCHOLOGIST_EMAIL=
DEMO_PSYCHOLOGIST_PASSWORD=
DEMO_CASE_MANAGER_EMAIL=
DEMO_CASE_MANAGER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Optional Resend email delivery for password reset.
# Required in production. In development, the reset link is shown in the UI.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
APP_BASE_URL=
