{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:first/:rest+",
      "destination": "/api/handler?__api_path=:first/:rest+"
    }
  ],
  "functions": {
    "api/[...route].mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    },
    "api/handler.mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    }
  }
}
