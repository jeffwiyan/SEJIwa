{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/handler?__api_path=health"
    },
    {
      "source": "/api/content",
      "destination": "/api/handler?__api_path=content"
    },
    {
      "source": "/api/bootstrap",
      "destination": "/api/handler?__api_path=bootstrap"
    },
    {
      "source": "/api/assistant/messages",
      "destination": "/api/handler?__api_path=assistant/messages"
    },
    {
      "source": "/api/complaints",
      "destination": "/api/handler?__api_path=complaints"
    },
    {
      "source": "/api/conversations",
      "destination": "/api/handler?__api_path=conversations"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/handler?__api_path=notifications"
    },
    {
      "source": "/api/profile",
      "destination": "/api/handler?__api_path=profile"
    },
    {
      "source": "/api/auth/:rest*",
      "destination": "/api/handler?__api_path=auth/:rest*"
    },
    {
      "source": "/api/admin/:rest*",
      "destination": "/api/handler?__api_path=admin/:rest*"
    },
    {
      "source": "/api/complaints/:id/:rest*",
      "destination": "/api/handler?__api_path=complaints/:id/:rest*"
    },
    {
      "source": "/api/conversations/:id/:rest*",
      "destination": "/api/handler?__api_path=conversations/:id/:rest*"
    },
    {
      "source": "/api/notifications/:id/:rest*",
      "destination": "/api/handler?__api_path=notifications/:id/:rest*"
    }
  ],
  "functions": {
    "api/[...route].mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    },
    "api/handler.mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    }
  }
}
