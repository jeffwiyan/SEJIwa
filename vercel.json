{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:rest*",
      "destination": "/api/handler?__api_path=auth/:rest*"
    },
    {
      "source": "/api/admin/:rest*",
      "destination": "/api/handler?__api_path=admin/:rest*"
    },
    {
      "source": "/api/complaints/:id/:rest*",
      "destination": "/api/handler?__api_path=complaints/:id/:rest*"
    },
    {
      "source": "/api/conversations/:id/:rest*",
      "destination": "/api/handler?__api_path=conversations/:id/:rest*"
    },
    {
      "source": "/api/notifications/:id/:rest*",
      "destination": "/api/handler?__api_path=notifications/:id/:rest*"
    }
  ],
  "functions": {
    "api/[...route].mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    },
    "api/handler.mjs": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    }
  }
}
